{
  "raw": {
    "ink": "#16231C",
    "paper": "#F6F2E7",
    "sage": "#8A9E92",
    "blue": "#2F7DE1",
    "amber": "#D98A1C",
    "gold": "#F2B630",
    "dot": "#FBE3A0"
  },
  "derived": {
    "amber-strong": "#9A5B0B",
    "blue-strong": "#1F5FB8",
    "ink-muted": "#5D6F65"
  },
  "light": {
    "bg": "paper",
    "surface": "#FFFDF8",
    "border": "#C9D1D9",
    "text": "ink",
    "text-muted": "ink-muted",
    "accent-bg": "gold",
    "accent-text": "amber-strong",
    "info": "blue-strong",
    "focus": "blue",
    "brand-primary": "amber",
    "brand-secondary": "gold",
    "brand-lab": "blue",
    "verdict-confirmed": "#0E6E63",
    "verdict-confirmed-tint": "#DDEFEA",
    "verdict-refuted": "#3B2470",
    "verdict-not-settled": "#909090",
    "verdict-not-settled-tint": "#E8EAE8",
    "state-error": "#C62A1E",
    "state-masked": "#3E4A44",
    "state-masked-bg": "#E4E6DF",
    "state-masked-border": "ink-muted",
    "state-insufficient": "ink-muted",
    "state-insufficient-border": "ink-muted",
    "state-loading": "text-muted",
    "state-in-progress": "ink-muted",
    "state-not-tested": "ink-muted",
    "state-partial-evidence": "info",
    "series-lead": "#B5800A",
    "series-cycle": "#2C8CC4",
    "verdict-refuted-tint": "#E9E3F4",
    "nav-bg": "ink",
    "nav-text": "#EDE6D3",
    "nav-text-muted": "#D7D0BE",
    "nav-heading": "#A9B4AC",
    "nav-current-bg": "#2B3A31",
    "nav-current-text": "surface",
    "nav-line": "#6B7D73",
    "nav-mark-confirmed": "#349887",
    "nav-mark-refuted": "#C8AEFF",
    "nav-mark-neutral": "#F2F4F1",
    "banner-bg": "#FBEFD2",
    "banner-text": "#6E3F05",
    "banner-line": "amber-strong",
    "data-wait": "#F2C66B",
    "data-work": "series-cycle",
    "data-wait-text": "#4A2A02",
    "data-work-tint": "#BFDDF0",
    "data-wait-strong": "amber-strong",
    "data-work-strong": "#1B5E85",
    "card-line": "#7E9487"
  },
  "scale": {
    "space-1": "0.25rem",
    "space-2": "0.5rem",
    "space-3": "1rem",
    "space-4": "1.5rem",
    "font-family": "\"IBM Plex Sans\", system-ui, sans-serif",
    "font-family-heading": "\"IBM Plex Serif\", Georgia, serif",
    "font-size-base": "1rem",
    "font-size-statement": "2.375rem",
    "font-size-figure": "4rem",
    "font-size-small": "0.875rem",
    "font-size-title": "1.5rem",
    "font-size-section": "1.25rem",
    "border-width": "1px",
    "series-line-width": "2px",
    "focus-ring-width": "4px",
    "focus-ring-offset": "0.25rem",
    "radius": "0.25rem",
    "content-max-width": "60rem",
    "shell-min-height": "100vh",
    "logo-height": "2.5rem",
    "icon-size": "1.5rem",
    "fiche-chart-min-height": "12rem",
    "barre-p85-hauteur": "1rem",
    "fiche-signal-border-width": "0.25rem",
    "cell-masked-background": "{state-masked-bg}",
    "cell-masked-color": "{state-masked}",
    "cell-masked-border-color": "{state-masked-border}",
    "cell-masked-font-style": "italic",
    "cell-masked-border-style": "dashed",
    "cell-insufficient-border-color": "{state-insufficient-border}",
    "cell-insufficient-border-style": "dotted",
    "cell-insufficient-background": "transparent",
    "cell-insufficient-font-style": "normal"
  },
  "pairs": [
    { "foreground": "text", "background": "bg", "kind": "text", "usage": "body text on the page" },
    { "foreground": "text", "background": "surface", "kind": "text", "usage": "text on cards and panels" },
    { "foreground": "text-muted", "background": "bg", "kind": "text", "usage": "secondary text on the page" },
    { "foreground": "text-muted", "background": "surface", "kind": "text", "usage": "secondary text on cards" },
    { "foreground": "accent-text", "background": "bg", "kind": "text", "usage": "underlined link on the page" },
    { "foreground": "accent-text", "background": "surface", "kind": "text", "usage": "underlined link on cards" },
    { "foreground": "text", "background": "accent-bg", "kind": "text", "usage": "main action" },
    { "foreground": "info", "background": "bg", "kind": "text", "usage": "information text on the page" },
    { "foreground": "info", "background": "surface", "kind": "text", "usage": "information text on cards" },
    { "foreground": "focus", "background": "surface", "kind": "interface", "usage": "focus ring on cards" },
    { "foreground": "focus", "background": "bg", "kind": "interface", "usage": "focus ring on the page" },
    { "foreground": "verdict-confirmed", "background": "bg", "kind": "text", "usage": "confirmed verdict on the page" },
    { "foreground": "verdict-confirmed", "background": "surface", "kind": "text", "usage": "confirmed verdict on cards" },
    { "foreground": "verdict-confirmed", "background": "verdict-confirmed-tint", "kind": "text", "usage": "confirmed verdict on its tint" },
    { "foreground": "verdict-refuted", "background": "bg", "kind": "text", "usage": "refuted verdict on the page" },
    { "foreground": "verdict-refuted", "background": "surface", "kind": "text", "usage": "refuted verdict on cards" },
    { "foreground": "verdict-not-settled", "background": "surface", "kind": "interface", "usage": "border and outline of the not settled verdict on cards (mid grey, never text)" },
    { "foreground": "text", "background": "verdict-not-settled-tint", "kind": "text", "usage": "label of the not settled verdict on its tint" },
    { "foreground": "state-error", "background": "bg", "kind": "text", "usage": "error text on the page" },
    { "foreground": "state-error", "background": "surface", "kind": "text", "usage": "error text on cards" },
    { "foreground": "state-masked", "background": "state-masked-bg", "kind": "text", "usage": "masked cell text" },
    { "foreground": "state-masked-border", "background": "surface", "kind": "interface", "usage": "dashed border of the masked cell" },
    { "foreground": "state-masked-border", "background": "state-masked-bg", "kind": "interface", "usage": "dashed border of the masked cell on its own background" },
    { "foreground": "state-insufficient-border", "background": "surface", "kind": "interface", "usage": "dotted outline of insufficient sample, no fill" },
    { "foreground": "state-in-progress", "background": "surface", "kind": "interface", "usage": "double outline of the in progress state" },
    { "foreground": "state-not-tested", "background": "surface", "kind": "interface", "usage": "full outline and empty circle of the not tested state" },
    { "foreground": "state-partial-evidence", "background": "bg", "kind": "text", "usage": "partial evidence, signals link on the page" },
    { "foreground": "state-partial-evidence", "background": "surface", "kind": "text", "usage": "partial evidence, signals link on cards" },
    { "foreground": "state-insufficient", "background": "surface", "kind": "text", "usage": "label of the insufficient sample in the chart" },
    { "foreground": "series-lead", "background": "surface", "kind": "interface", "usage": "lead time series of the chart on cards" },
    { "foreground": "series-lead", "background": "bg", "kind": "interface", "usage": "lead time series of the chart on the page" },
    { "foreground": "series-cycle", "background": "surface", "kind": "interface", "usage": "cycle time series of the chart on cards" },
    { "foreground": "series-cycle", "background": "bg", "kind": "interface", "usage": "cycle time series of the chart on the page" },
    { "foreground": "nav-text", "background": "nav-bg", "kind": "text", "usage": "entries and fields of the side column" },
    { "foreground": "nav-text-muted", "background": "nav-bg", "kind": "text", "usage": "secondary entries of the side column" },
    { "foreground": "nav-heading", "background": "nav-bg", "kind": "text", "usage": "small section titles of the side column" },
    { "foreground": "nav-current-text", "background": "nav-current-bg", "kind": "text", "usage": "current entry of the side column" },
    { "foreground": "nav-line", "background": "nav-bg", "kind": "interface", "usage": "frame of the buttons of the side column" },
    { "foreground": "nav-mark-confirmed", "background": "nav-bg", "kind": "interface", "usage": "confirmed marker in the side column" },
    { "foreground": "nav-mark-refuted", "background": "nav-bg", "kind": "interface", "usage": "refuted marker in the side column" },
    { "foreground": "nav-mark-neutral", "background": "nav-bg", "kind": "interface", "usage": "outline of the other markers in the side column" },
    { "foreground": "nav-mark-confirmed", "background": "nav-current-bg", "kind": "interface", "usage": "confirmed marker on the current entry" },
    { "foreground": "nav-mark-refuted", "background": "nav-current-bg", "kind": "interface", "usage": "refuted marker on the current entry" },
    { "foreground": "nav-mark-neutral", "background": "nav-current-bg", "kind": "interface", "usage": "outline of the other markers on the current entry" },
    { "foreground": "banner-text", "background": "banner-bg", "kind": "text", "usage": "synthetic data banner" },
    { "foreground": "banner-line", "background": "banner-bg", "kind": "interface", "usage": "bottom line of the synthetic data banner" },
    { "foreground": "data-wait-text", "background": "data-wait", "kind": "text", "usage": "label inside the waiting part of a bar" },
    { "foreground": "text", "background": "data-work-tint", "kind": "text", "usage": "label inside the work part of a bar, in ink on a lighter work tint" },
    { "foreground": "data-wait-strong", "background": "surface", "kind": "text", "usage": "key figure of the waiting on cards" },
    { "foreground": "data-work-strong", "background": "surface", "kind": "text", "usage": "key figure of the work on cards" },
    { "foreground": "card-line", "background": "surface", "kind": "interface", "usage": "outline of the cards of the conviction pages" },
    { "foreground": "verdict-refuted", "background": "verdict-refuted-tint", "kind": "text", "usage": "refuted verdict on its tint" },
    { "foreground": "data-work", "background": "surface", "kind": "interface", "usage": "work part of a bar and of the chart on cards" },
    { "foreground": "state-insufficient", "background": "bg", "kind": "text", "usage": "label of the insufficient sample badge on the page, no fill" },
    { "foreground": "state-insufficient-border", "background": "bg", "kind": "interface", "usage": "dotted outline of the insufficient sample card and badge on the page, no fill" }
  ],
  "states": {
    "verdict-confirmed": { "label": "verdict.confirmed", "icon": "check", "outline": "solid" },
    "verdict-refuted": { "label": "verdict.refuted", "icon": "cross", "outline": "solid" },
    "verdict-not-settled": { "label": "verdict.not_settled", "icon": "tilde", "outline": "solid" },
    "state-masked": { "label": "cellState.masked", "icon": "none", "outline": "dashed" },
    "state-insufficient": { "label": "state.insufficient_sample", "icon": "ellipsis", "outline": "dotted" },
    "state-error": { "label": "state.error", "icon": "alert", "outline": "solid" },
    "state-loading": { "label": "page.loading", "icon": "indicator", "outline": "none" },
    "state-in-progress": { "label": "state.in_progress", "icon": "clock", "outline": "double" },
    "state-not-tested": { "label": "state.not_tested", "icon": "circle-empty", "outline": "solid" },
    "state-partial-evidence": { "label": "state.partial_evidence_signals", "icon": "info", "outline": "hatched" }
  }
}
