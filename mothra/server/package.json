{
  "name": "@mothra/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mothra server package: Fastify routes over the aggregated views. Imports the contract package, never the front.",
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test \"test/*.test.ts\" && node --test --test-concurrency=1 \"test/db/*.test.ts\"",
    "test:coverage": "node ../outils/couverture.mjs server"
  },
  "dependencies": {
    "@fastify/static": "10.1.9",
    "@fastify/type-provider-typebox": "6.3.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "typebox": "1.4.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
