#!/usr/bin/env python3
"""Faux `gh` des tests de gh_issue.py et de l'import, en ligne de commande : mince enveloppe du cœur fake_gh_core.py.

Environnement, modes et journal : voir fake_gh_core.py. Un mode de blocage fait dormir ce processus 60 s (le délai de l'outil
le tue avant).
"""
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import fake_gh_core  # noqa: E402

stdin = None if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read()
try:
    devnull = os.path.samestat(os.fstat(0), os.stat(os.devnull))
except OSError:
    devnull = False
try:
    code, out, err = fake_gh_core.handle(sys.argv[1:], stdin, os.environ, devnull)
except fake_gh_core.Hang:
    time.sleep(60)
    sys.exit(0)
sys.stdout.write(out)
sys.stderr.write(err)
sys.exit(code)
