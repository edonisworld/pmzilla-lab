#!/usr/bin/env python3
"""Faux `gh` des tests du lecteur GitHub : aucune requête réseau.

Environnement : FAKE_GH_DATA (JSON : liste de noeuds d'issues au format GraphQL), FAKE_GH_LOG (fichier où chaque appel est noté),
FAKE_GH_MODE (offline | hang (aucune réponse, dort 30 s) | auth | graphql_error | graphql_error_perso | json_errors_perso, ces deux-là avec FAKE_GH_SECRET), FAKE_GH_PAGE (taille de page, 100 par défaut).
Il ne répond qu'à `api graphql` sans mutation ; tout autre appel est noté et refusé (code 2).
"""
import json
import os
import sys

args = sys.argv[1:]
if os.environ.get("FAKE_GH_LOG"):
    with open(os.environ["FAKE_GH_LOG"], "a", encoding="utf-8") as f:
        f.write(json.dumps(args) + "\n")
mode = os.environ.get("FAKE_GH_MODE", "")
if mode == "offline":
    sys.stderr.write("error connecting to api.github.com\n")
    sys.exit(1)
if mode == "hang":
    import time
    time.sleep(30)
    sys.exit(1)
if mode == "auth":
    sys.stderr.write("To get started with GitHub CLI, please run:  gh auth login\n")
    sys.exit(4)
if args[:2] != ["api", "graphql"] or any("mutation" in a.lower() for a in args):
    sys.stderr.write("fake gh: appel non pris en charge\n")
    sys.exit(2)
if mode == "graphql_error":
    sys.stderr.write("GraphQL: Field 'blockedBy' doesn't exist on type 'Issue'\n")
    sys.exit(1)
if mode == "graphql_error_perso":
    sys.stderr.write("GraphQL: Could not resolve to a Repository with the name '%s/depot'. (HTTP 403)\n" % os.environ["FAKE_GH_SECRET"])
    sys.exit(1)
if mode == "json_errors_perso":
    print(json.dumps({"errors": [{"message": "no access for %s/depot" % os.environ["FAKE_GH_SECRET"]}]}))
    sys.exit(0)
valeurs = {}
for k, a in enumerate(args):
    if a in ("-F", "-f") and k + 1 < len(args) and "=" in args[k + 1]:
        nom, _, v = args[k + 1].partition("=")
        valeurs[nom] = v
data = json.load(open(os.environ["FAKE_GH_DATA"], encoding="utf-8"))
taille = int(os.environ.get("FAKE_GH_PAGE", "100"))
debut = int(valeurs.get("after") or 0)
fin = debut + taille
# jalons du dépôt : ceux des issues, plus FAKE_GH_MILESTONES (JSON : liste de {title, state})
jalons = {}
for n in data:
    if n.get("milestone"):
        jalons[n["milestone"]["title"]] = n["milestone"]["state"]
for j in json.loads(os.environ.get("FAKE_GH_MILESTONES") or "[]"):
    jalons[j["title"]] = j["state"]
print(json.dumps({"data": {"repository": {"milestones": {"nodes": [{"title": t, "state": e} for t, e in jalons.items()]}, "issues": {
    "pageInfo": {"hasNextPage": fin < len(data), "endCursor": str(fin)},
    "nodes": data[debut:fin]}}}}))
