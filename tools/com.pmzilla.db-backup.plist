<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modèle : __HOME__ est remplacé par le dossier personnel à l'installation (voir docs/pmzilla/installation.md, section 14). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pmzilla.db-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/PMZilla-Lab/db_backup.sh</string>
  </array>
  <!-- Chaque jour à 7 h 45, après la collecte de la veille (7 h 10). Si le Mac dort à cette heure, launchd lance la tâche au réveil. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>
  <!-- DB_BACKUP_NOTIFIER=1 : notification macOS en cas d'échec. Pour garder plus ou moins de sauvegardes (14 par défaut), ajouter ici la clé DB_BACKUP_GARDER. Aucun mot de passe dans ce fichier : le script n'en utilise pas. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>DB_BACKUP_NOTIFIER</key>
    <string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/pmzilla-db-backup.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/pmzilla-db-backup.log</string>
</dict>
</plist>
