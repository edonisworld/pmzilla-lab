<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modèle : __HOME__ est remplacé par le dossier personnel à l'installation (voir docs/pmzilla/installation.md). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pmzilla.watch-catchup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/PMZilla-Lab/watch.sh</string>
    <string>--catch-up</string>
  </array>
  <!-- Rattrapage : au chargement (ouverture de session), puis toutes les heures. Le script décide s'il y a quelque chose à faire. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/pmzilla-watch.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/pmzilla-watch.log</string>
</dict>
</plist>
