<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modèle : __HOME__ est remplacé par le dossier personnel et __LAB__ par le dossier du lab (le parent du dépôt de développement) à l'installation (voir docs/pmzilla/installation.md). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pmzilla.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__LAB__/watch.sh</string>
    <string>--if-due</string>
  </array>
  <!-- Chaque jour à 7 h 10. Si le Mac dort à cette heure, launchd lance la tâche au réveil. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/pmzilla-watch.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/pmzilla-watch.log</string>
</dict>
</plist>
